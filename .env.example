# Round Digital — environment
#
# Copy to .env.local for development, and set the same keys in the hosting
# provider for production. Without these three the contact and RFP forms POST
# correctly, validate correctly, and then fail to deliver: /api/contact returns
# 500 and /api/rfp returns 502. Both surface a visible error with a fallback
# email address rather than silently dropping the enquiry, but no message
# reaches anyone until these are set.

# Gmail account the site sends *from*. With 2FA enabled this must be a Google
# App Password, not the account password.
EMAIL_USER=
EMAIL_PASS=

# Inbox that receives contact and RFP submissions.
EMAIL_RECEIVER=
